# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider feature flag
LLM_PROVIDER=groq                  # groq | anthropic

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# Frontend — Vite (VITE_ prefix required for browser exposure)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8000

# Observability — runtime context
ENVIRONMENT=staging

# Sentry — backend
SENTRY_DSN_BACKEND=
SENTRY_TRACES_SAMPLE_RATE=0.2

# Sentry — frontend (Vite requires VITE_ prefix)
VITE_SENTRY_DSN_FRONTEND=
VITE_SENTRY_ENVIRONMENT=staging

# SENTRY_DSN_FRONTEND stored in Doppler for reference; only VITE_SENTRY_DSN_FRONTEND is read by the browser bundle
SENTRY_DSN_FRONTEND=

# Grafana Cloud — metrics push (Prometheus remote write)
GRAFANA_PROMETHEUS_REMOTE_WRITE_URL=
GRAFANA_PROMETHEUS_INSTANCE_ID=
GRAFANA_API_TOKEN=

# Grafana Cloud — log forwarding handled by Render Log Streams (no code needed)
# Kept here for reference / manual push fallback only
GRAFANA_LOKI_PUSH_URL=
GRAFANA_LOKI_INSTANCE_ID=

# Metrics endpoint protection
METRICS_BEARER_TOKEN=